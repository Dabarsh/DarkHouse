#version 450
#extension GL_GOOGLE_include_directive : require
// DarkHouse — white balance (WhiteBalanceNode in color_nodes.hpp).
//
// One 3x3 matrix per pixel: the Bradford adaptation from the scene illuminant
// (temperature + tint) to the 5500 K reference, folded together with the
// Rec.709 <-> XYZ conversions on the CPU (whiteBalancePush in
// src/color_adjust.cpp). Alpha passes through.

#include "color_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly  image2D inputImage;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D outputImage;

// Must match darkhouse::WhiteBalancePush (48 bytes).
layout(push_constant) uniform WhiteBalance {
    vec4 rows[3];  // row-major matrix, xyz used
} params;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(coord, imageSize(outputImage)))) return;
    vec4 source = imageLoad(inputImage, coord);
    vec3 rgb = vec3(dot(params.rows[0].xyz, source.rgb), dot(params.rows[1].xyz, source.rgb),
                    dot(params.rows[2].xyz, source.rgb));
    imageStore(outputImage, coord, vec4(storable(rgb), source.a));
}
