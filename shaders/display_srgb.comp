#version 450
// DarkHouse — display transform (DisplayTransformNode in render_pipeline.hpp).
//
// The last node of the develop graph: scene-linear rgba16f in, sRGB-encoded
// RGBA8 out, for the UNORM swapchain the UI draws into. Values outside [0, 1]
// are clipped (tone mapping belongs to a develop node). A triangular dither
// of +-1 LSB, fixed per pixel, hides 8-bit banding in smooth gradients
// (pure black and white are left exact).
// Alpha stays straight. A channel view (Canvas > Channels) shows one of
// red, green, blue or alpha as an opaque grey image instead.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly  image2D inputImage;
layout(set = 0, binding = 1, rgba8)   uniform writeonly image2D outputImage;

// Must match darkhouse::DisplayTransformNode (DisplayChannel): 0 = colour,
// 1..3 = red, green, blue, 4 = alpha.
layout(push_constant) uniform Display {
    uint channel;
} params;

vec3 encodeSrgb(vec3 linear) {
    vec3 c = clamp(linear, 0.0, 1.0);
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}

// pcg2d (Jarzynski & Olano 2020): two independent uniform hashes per pixel.
uvec2 pcg2d(uvec2 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y * 1664525u;
    v.y += v.x * 1664525u;
    v ^= v >> 16u;
    v.x += v.y * 1664525u;
    v.y += v.x * 1664525u;
    v ^= v >> 16u;
    return v;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(coord, imageSize(outputImage)))) return;
    vec4 source = imageLoad(inputImage, coord);
    // NaN (from an upstream node) must not reach the clamp as "anything".
    vec3 rgb = mix(source.rgb, vec3(0.0), isnan(source.rgb));

    vec3 encoded = encodeSrgb(rgb);
    float sourceAlpha = isnan(source.a) ? 0.0 : source.a;
    if (params.channel >= 1u && params.channel <= 3u) {
        encoded = vec3(encoded[params.channel - 1u]);
        sourceAlpha = 1.0;
    } else if (params.channel == 4u) {
        encoded = vec3(clamp(sourceAlpha, 0.0, 1.0));
        sourceAlpha = 1.0;
    }
    vec2 u = vec2(pcg2d(uvec2(coord))) * (1.0 / 4294967296.0);
    // Triangular, (-1, 1); pure black and white stay exact.
    vec3 dither = (u.x + u.y - 1.0) * vec3(greaterThan(encoded, vec3(0.0))) * vec3(lessThan(encoded, vec3(1.0)));
    vec3 level = clamp(floor(encoded * 255.0 + 0.5 + dither), 0.0, 255.0);
    // The + 0.25 makes the stored bytes `level` and `alpha` whether the
    // implementation rounds to nearest or towards zero when it converts to UNORM.
    float alpha = floor(clamp(sourceAlpha, 0.0, 1.0) * 255.0 + 0.5);
    imageStore(outputImage, coord, (vec4(level, alpha) + 0.25) / 255.0);
}
