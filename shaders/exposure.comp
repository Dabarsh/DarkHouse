#version 450
#extension GL_GOOGLE_include_directive : require
// DarkHouse — exposure / tone compute node (ExposureNode in render_pipeline.hpp).
//
// Works on scene-referred linear RGBA16F. The order is exposure gain, then
// highlight/shadow tone shaping, then contrast. Every step is multiplicative
// or pivots on middle grey, so a grey card at 0.18 keeps its value while
// contrast changes. Alpha passes through unchanged.

#include "tone_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly  image2D inputImage;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D outputImage;

// Must match darkhouse::ExposureParams (16 bytes).
layout(push_constant) uniform ExposureParams {
    float exposureCompensation;  // EV stops; linear gain = 2^EV
    float highlights;            // [-1, 1]; negative recovers, positive boosts
    float shadows;               // [-1, 1]; positive lifts, negative deepens
    float contrast;              // [-1, 1]; 0 = identity
} params;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = imageSize(inputImage);
    if (coord.x >= size.x || coord.y >= size.y) {
        return;  // partial workgroup at the right or bottom edge
    }

    vec4 source = imageLoad(inputImage, coord);
    vec3 rgb = applyTone(source.rgb, params.exposureCompensation, params.highlights, params.shadows, params.contrast);
    imageStore(outputImage, coord, vec4(rgb, source.a));
}
